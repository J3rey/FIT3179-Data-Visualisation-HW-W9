{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Athlete Age Distribution by Gender",
  "width": 500,
  "height": 300,
  "data": {
    "url": "data/athletes_name_gender_age.csv"
  },
  "transform": [
    {
      "bin": { "step": 5 },
      "field": "age",
      "as": ["age_start", "age_end"]
    },
    {
      "aggregate": [{ "op": "count", "as": "count" }],
      "groupby": ["gender", "age_start"]
    },
    {
      "calculate": "datum.gender === 'Male' ? -datum.count : datum.count",
      "as": "signed_count"
    }
  ],
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "age_start",
      "type": "ordinal",
      "title": "Age"
    },
    "x": {
      "field": "signed_count",
      "type": "quantitative",
      "title": "Count"
    },
    "color": {
      "field": "gender",
      "type": "nominal"
    }
  }
}
