{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Athlete Age Distribution by Gender",
  "width": 500,
  "height": 300,
  "data": {
    "url": "data/athletes_name_gender_age.csv"
  },
  "transform": [
    {
      "bin": { "step": 5 },
      "field": "age",
      "as": ["age_start", "age_end"]
    },
    {
      "aggregate": [{ "op": "count", "as": "count" }],
      "groupby": ["gender", "age_start", "age_end"]
    },
    {
      "calculate": "datum.gender === 'Male' ? -datum.count : datum.count",
      "as": "signed_count"
    },
    {
      "calculate": "abs(datum.signed_count)",
      "as": "abs_count"
    },
    {
      "calculate": "format(datum.age_start, 'd') + '-' + format(datum.age_end - 1, 'd')",
      "as": "age_range"
    }
  ],
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "age_start",
      "type": "ordinal",
      "title": "Age"
    },
    "x": {
      "field": "signed_count",
      "type": "quantitative",
      "title": "Count"
    },
    "color": {
      "field": "gender",
      "type": "nominal"
    },
    "tooltip": [
      {
        "field": "age_range",
        "type": "nominal",
        "title": "Age Range"
      },
      {
        "field": "gender",
        "type": "nominal",
        "title": "Gender"
      },
      {
        "field": "abs_count",
        "type": "quantitative",
        "title": "Number of Athletes"
      }
    ]
  }
}
