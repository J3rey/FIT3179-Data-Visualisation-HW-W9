{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Butterfly chart of athlete counts by age range and gender. Legend selection filters age ranges.",
  "data": { "url": "athletes_name_gender_age.csv" },

  "transform": [
    {
      "bin": { "step": 5 },
      "field": "age",
      "as": ["age_bin_start", "age_bin_end"]
    },
    {
      "aggregate": [{ "op": "count", "as": "count" }],
      "groupby": ["gender", "age_bin_start", "age_bin_end"]
    },
    {
      "calculate": "datum.gender === 'Male' ? -datum.count : datum.count",
      "as": "signed_count"
    },
    {
      "calculate": "format(datum.age_bin_start, 'd') + ' to ' + format(datum.age_bin_end, 'd')",
      "as": "age_range"
    },
    { "calculate": "abs(datum.signed_count)", "as": "abs_count" }
  ],

  "params": [
    {
      "name": "ageRange",
      "select": { "type": "point", "fields": ["age_range"] },
      "bind": "legend"
    }
  ],

  "layer": [
    {
      "mark": { "type": "bar" },
      "encoding": {
        "y": {
          "field": "age_range",
          "type": "ordinal",
          "sort": "ascending",
          "axis": { "title": "Age range" }
        },
        "x": {
          "field": "signed_count",
          "type": "quantitative",
          "axis": { "title": "Count" }
        },
        "color": {
          "field": "age_range",
          "type": "nominal",
          "legend": { "title": "Filter by age range" }
        },
        "opacity": {
          "condition": { "param": "ageRange", "value": 1 },
          "value": 0.2
        },
        "tooltip": [
          { "field": "age_range", "title": "Age range" },
          { "field": "gender", "title": "Gender" },
          { "field": "abs_count", "type": "quantitative", "title": "Count" }
        ]
      }
    },

    {
      "mark": { "type": "rule", "aria": false },
      "encoding": { "x": { "value": 0 } }
    },

    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "dx": -8,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": { "value": 0 },
        "y": { "value": 0 },
        "text": { "value": "Males on the left" }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 8,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": { "value": 0 },
        "y": { "value": 0 },
        "text": { "value": "Females on the right" }
      }
    }
  ],

  "config": {
    "bar": { "size": 12 },
    "axis": { "grid": false }
  }
}
