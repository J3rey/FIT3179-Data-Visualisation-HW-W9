{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Athlete Age Distribution",
    "fontSize": 20,
    "fontWeight": "bold",
    "anchor": "middle",
    "offset": 20
  },
  "width": 750,
  "height": 450,
  "padding": { "left": 10, "right": 10, "top": 10, "bottom": 10 },

  "data": {
    "url": "data/athletes_name_gender_age.csv"
  },

  "params": [
    {
      "name": "gender_selection",
      "select": { "type": "point", "fields": ["gender"] },
      "bind": "legend"
    },
    {
      "name": "age_10_14",
      "value": true,
      "bind": { "input": "checkbox", "name": "10-14 years: " }
    },
    {
      "name": "age_15_19",
      "value": true,
      "bind": { "input": "checkbox", "name": "15-19 years: " }
    },
    {
      "name": "age_20_24",
      "value": true,
      "bind": { "input": "checkbox", "name": "20-24 years: " }
    },
    {
      "name": "age_25_29",
      "value": true,
      "bind": { "input": "checkbox", "name": "25-29 years: " }
    },
    {
      "name": "age_30_34",
      "value": true,
      "bind": { "input": "checkbox", "name": "30-34 years: " }
    },
    {
      "name": "age_35_39",
      "value": true,
      "bind": { "input": "checkbox", "name": "35-39 years: " }
    },
    {
      "name": "age_40_44",
      "value": true,
      "bind": { "input": "checkbox", "name": "40-44 years: " }
    },
    {
      "name": "age_45_49",
      "value": true,
      "bind": { "input": "checkbox", "name": "45-49 years: " }
    },
    {
      "name": "age_50_54",
      "value": true,
      "bind": { "input": "checkbox", "name": "50-54 years: " }
    },
    {
      "name": "age_55_59",
      "value": true,
      "bind": { "input": "checkbox", "name": "55-59 years: " }
    },
    {
      "name": "age_60_64",
      "value": true,
      "bind": { "input": "checkbox", "name": "60-64 years: " }
    },
    {
      "name": "age_65_69",
      "value": true,
      "bind": { "input": "checkbox", "name": "65-69 years: " }
    }
  ],

  "transform": [
    { "bin": { "step": 5 }, "field": "age", "as": ["age_start", "age_end"] },
    {
      "calculate": "format(datum.age_start, 'd') + ' to ' + format(datum.age_end - 1, 'd')",
      "as": "age_range"
    },
    {
      "aggregate": [{ "op": "count", "as": "count" }],
      "groupby": ["gender", "age_start", "age_end", "age_range"]
    },
    {
      "filter": "(datum.age_range == '10 to 14' && age_10_14) || (datum.age_range == '15 to 19' && age_15_19) || (datum.age_range == '20 to 24' && age_20_24) || (datum.age_range == '25 to 29' && age_25_29) || (datum.age_range == '30 to 34' && age_30_34) || (datum.age_range == '35 to 39' && age_35_39) || (datum.age_range == '40 to 44' && age_40_44) || (datum.age_range == '45 to 49' && age_45_49) || (datum.age_range == '50 to 54' && age_50_54) || (datum.age_range == '55 to 59' && age_55_59) || (datum.age_range == '60 to 64' && age_60_64) || (datum.age_range == '65 to 69' && age_65_69)"
    }
  ],

  "mark": {
    "type": "bar",
    "width": { "band": 0.7 }
  },

  "encoding": {
    "x": {
      "field": "age_range",
      "type": "ordinal",
      "title": "Age Range",
      "sort": [
        "10 to 14",
        "15 to 19",
        "20 to 24",
        "25 to 29",
        "30 to 34",
        "35 to 39",
        "40 to 44",
        "45 to 49",
        "50 to 54",
        "55 to 59",
        "60 to 64",
        "65 to 69"
      ],
      "axis": {
        "labelFontSize": 11,
        "titleFontSize": 14,
        "titleFontWeight": "bold",
        "labelAngle": -45,
        "labelPadding": 5,
        "grid": false
      }
    },
    "y": {
      "field": "count",
      "type": "quantitative",
      "title": "Number of Athletes",
      "axis": {
        "labelFontSize": 11,
        "titleFontSize": 14,
        "titleFontWeight": "bold",
        "grid": true,
        "gridOpacity": 0.3
      }
    },
    "color": {
      "field": "gender",
      "type": "nominal",
      "scale": {
        "domain": ["Male", "Female"],
        "range": ["#2F7FB8", "#E28E2C"]
      },
      "legend": {
        "title": "Gender",
        "orient": "top-right",
        "direction": "horizontal",
        "titleFontSize": 14,
        "titleFontWeight": "bold",
        "labelFontSize": 12,
        "symbolSize": 150,
        "padding": 15,
        "offset": 10,
        "titlePadding": 10
      }
    },
    "opacity": {
      "condition": { "param": "gender_selection", "value": 1 },
      "value": 0.25
    },
    "tooltip": [
      { "field": "age_range", "type": "nominal", "title": "Age Range" },
      { "field": "gender", "type": "nominal", "title": "Gender" },
      {
        "field": "count",
        "type": "quantitative",
        "title": "Number of Athletes"
      }
    ]
  },

  "usermeta": {
    "embedOptions": {
      "actions": false,
      "padding": { "top": 10, "left": 10, "right": 10, "bottom": 80 }
    }
  },

  "config": {
    "view": {
      "stroke": null,
      "fill": "white",
      "cornerRadius": 10
    },
    "axis": {
      "labelLimit": 120,
      "titlePadding": 15,
      "gridColor": "#e0e0e0",
      "domainColor": "#adb5bd",
      "tickColor": "#adb5bd"
    },
    "bar": {
      "binSpacing": 2
    },
    "style": {
      "guide-label": {
        "fontSize": 12,
        "fill": "#495057"
      },
      "guide-title": {
        "fontSize": 14,
        "fontWeight": "bold",
        "fill": "#2c3e50"
      }
    },
    "legend": {
      "cornerRadius": 5,
      "fillColor": "#f8f9fa",
      "strokeColor": "#dee2e6",
      "padding": 10
    },
    "range": {
      "category": [
        "#2F7FB8",
        "#E28E2C",
        "#52A447",
        "#C44E52",
        "#8C6BB1",
        "#FFA500"
      ]
    }
  }
}
